---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/constants';

const lastUpdated = 'August 6, 2026';
---

<BaseLayout
  title="Disclaimer"
  description="Disclaimer for GST Calculator India. Important information about the accuracy and limitations of our GST calculator."
  path="/disclaimer"
>
  <article class="mx-auto max-w-2xl px-4 py-14 sm:px-6 sm:py-20">
    <header class="text-center">
      <p class="classy-label">Legal</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">Disclaimer</h1>
      <div class="classy-divider mt-6"></div>
      <p class="mt-4 text-sm italic text-muted dark:text-cream/50">Last updated: {lastUpdated}</p>
    </header>

    <div class="prose-classy mt-12">
      <section class="border border-gold/30 bg-brand-50/50 p-5 dark:border-gold/20 dark:bg-gold/5">
        <p class="font-serif text-lg text-navy dark:text-cream">
          This calculator is provided for informational and educational purposes only. It does not constitute tax, legal, or financial advice.
        </p>
      </section>

      <section>
        <h2>No Professional Advice</h2>
        <p class="mt-3">
          The information provided by {SITE.name} is general in nature and should not be relied upon as a substitute for professional advice from a qualified chartered accountant, tax consultant, or legal advisor.
        </p>
      </section>

      <section>
        <h2>Accuracy of Calculations</h2>
        <p class="mt-3">
          Whilst we strive for accuracy, we make no warranties regarding the completeness or reliability of results. Rounding differences, special GST categories, exemptions, and cess may affect actual tax amounts.
        </p>
      </section>

      <section>
        <h2>GST Rate Changes</h2>
        <p class="mt-3">
          GST rates are determined by the GST Council and may change periodically. Users are responsible for confirming the applicable rate for their specific transaction.
        </p>
      </section>

      <section>
        <h2>Limitation of Liability</h2>
        <p class="mt-3">
          {SITE.name} shall not be liable for any damages arising from the use of this website or reliance upon its calculations. Use of this tool is at your own discretion.
        </p>
      </section>

      <section>
        <h2>Contact</h2>
        <p class="mt-3">
          Enquiries regarding this disclaimer may be sent to{' '}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
