---
import BaseLayout from '../layouts/BaseLayout.astro';
import GSTCalculator from '../components/GSTCalculator.astro';
import FAQ from '../components/FAQ.astro';
---

<BaseLayout path="/">
  <GSTCalculator />
  <FAQ />

  <section class="border-t-2 border-charcoal/20 bg-cream/40 py-16 dark:border-cream/20 dark:bg-navy/30">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="classy-divider mb-12"></div>
      <div class="grid gap-10 sm:grid-cols-3 sm:gap-8 border-t border-b border-charcoal/15 py-8 dark:border-cream/15">
        <article class="text-center sm:text-left border-b border-charcoal/15 pb-8 sm:border-0 sm:pb-0 sm:border-r sm:pr-8 dark:border-cream/15">
          <h3 class="font-serif text-xl font-bold">Instant Results</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted dark:text-cream/60">
            Calculations appear immediately as you type — no delays, no page reloads.
          </p>
        </article>
        <article class="text-center sm:text-left border-b border-charcoal/15 pb-8 sm:border-0 sm:pb-0 sm:border-r sm:px-8 dark:border-cream/15">
          <h3 class="font-serif text-xl font-bold">Any Device</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted dark:text-cream/60">
            A considered layout that adapts gracefully from mobile to desktop.
          </p>
        </article>
        <article class="text-center sm:text-left sm:pl-8">
          <h3 class="font-serif text-xl font-bold">Entirely Free</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted dark:text-cream/60">
            No registration required. Use as often as you need, without charge.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
